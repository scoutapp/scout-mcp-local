{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.scoutapm/scout-mcp-local",
  "title": "Scout APM (local)",
  "description": "Run Scout APM's MCP tools locally with an API key: endpoints, traces, errors, and N+1 insights.",
  "websiteUrl": "https://scoutapm.com/docs/ai/mcp-local",
  "repository": {
    "url": "https://github.com/scoutapp/scout-mcp-local",
    "source": "github"
  },
  "version": "2026.9.28",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "scout-mcp-local",
      "version": "2026.9.28",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Your API key for Scout Monitoring.",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "SCOUT_API_KEY"
        }
      ]
    },
    {
      "registryType": "oci",
      "identifier": "docker.io/scoutapp/scout-mcp-local:latest",
      "environmentVariables": [
        {
          "name": "SCOUT_API_KEY",
          "description": "Your API key for Scout Monitoring.",
          "isRequired": true,
          "isSecret": true
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}