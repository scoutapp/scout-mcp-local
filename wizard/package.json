{
  "name": "@scout_apm/wizard",
  "version": "2026.5.5",
  "description": "Scout Wizard",
  "main": "dist/scout-wizard.js",
  "repository": "github:scoutapp/scout-mcp-local",
  "bin": {
    "scout-wizard": "dist/wizard.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "vite build && chmod +x ./dist/wizard.js && mkdir -p dist/lib/templates && cp src/lib/templates/*.template dist/lib/templates/",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stylize": "npm run lint && npm run format",
    "style": "npm run lint && npm run format:check",
    "check": "npm run style && npm test",
    "prepare": "lefthook install"
  },
  "keywords": [
    "Scout",
    "APM",
    "Monitoring",
    "MCP"
  ],
  "author": "Scout Monitoring",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "chalk": "^5.6.2",
    "open": "^11.0.0",
    "ora": "^9.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.6.0",
    "@vitest/ui": "^4.1.5",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.6",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.10",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
